#############################################################################
# Reconix — environment configuration
#
# Copy to .env and edit:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.
#
# One .env configures the whole application: the Reconix TUI and the backend
# pentest harness it drives. LLM selection is managed in the TUI with the
# /provider and /model commands; the values below seed the default provider.
#############################################################################


#============================================================================
# LLM  (required)
#
# This block defines the built-in "reconix" provider — the default /model, and
# the single LLM config shared by the TUI and the harness agent. Point it at any
# OpenAI-compatible endpoint. Its API key is entered in the TUI with /provider
# (stored encrypted), not here. Add and switch other providers there too.
#
# LLM_BASE_URL  the endpoint's base URL (ends in /v1 for most servers)
# LLM_MODEL     the model id to use
# LLM_TIMEOUT   per-request timeout in seconds
#============================================================================
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=your-model-id
LLM_TIMEOUT=120


#============================================================================
# LLM storage  (optional — defaults shown)
#
# Where the TUI keeps the providers you add with /provider. API keys are
# encrypted with the Fernet key in LLM_KEY_FILE (created 0600 on first use).
#============================================================================
LLM_DB=~/.reconix/llm.db
LLM_KEY_FILE=~/.reconix/llm.key


#============================================================================
# Kali MCP server  (required for scans — DansPK/kali-mcp-server)
#
# The agent runs security tools on a Kali box through this MCP server.
# Transport: http | sse | stdio
#============================================================================
KALI_MCP_TRANSPORT=http

# http / sse — connect to an exposed endpoint, with an optional bearer token.
KALI_MCP_URL=http://your-kali-host:8080/mcp
KALI_MCP_AUTH_TOKEN=

# stdio — the harness launches this command and speaks MCP over its stdio.
# To reach a server on a remote host, run it over SSH (key-based auth); the
# whole remote command is passed as one ssh argument. Only used for stdio.
KALI_MCP_SSH_HOST=user@your-kali-host
KALI_MCP_REMOTE_CMD=/path/to/kali-mcp-server/.venv/bin/python -m kali_mcp.server


#============================================================================
# Storage  (optional — default shown)
#
# The harness's SQLite database of targets, scans and findings.
#============================================================================
HARNESS_DB_PATH=~/.reconix/harness.db
