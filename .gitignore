**/venv/
**/.next/
**/out/
**/dist/
**/build/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
*.pyc
*.egg-info/
*.tsbuildinfo

# secrets / local state
**/.env
**/.env.*
!**/.env.example
*.key
*.pem
**/.reconix/
**/data/
