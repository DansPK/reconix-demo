# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- LLM (OpenAI-compatible endpoint) ---
# Works with any OpenAI-compatible server (OpenAI, Ollama's /v1, vLLM, BytePlus Ark, etc.).
HARNESS_LLM_BASE_URL=http://localhost:11434/v1
HARNESS_LLM_API_KEY=sk-not-needed-for-local
HARNESS_LLM_MODEL=qwen2.5-coder:14b

# --- Kali MCP server (DansPK/kali-mcp-server) connection ---
# Transport: stdio | http | sse
KALI_MCP_TRANSPORT=stdio

# stdio transport: the harness launches this command and speaks MCP over its stdio.
# To reach the server running ON the Kali VM, launch it over SSH (key-based auth).
# The whole remote command is passed as a single ssh argument.
KALI_MCP_SSH_HOST=kali@192.168.210.130
KALI_MCP_REMOTE_CMD=/opt/kali-mcp-server/.venv/bin/python -m kali_mcp.server

# http/sse transport: connect to an exposed endpoint instead of SSH.
KALI_MCP_URL=http://192.168.210.130:8080/mcp

# Optional bearer token (server supports KALI_MCP_AUTH_TOKEN auth).
KALI_MCP_AUTH_TOKEN=

# --- Storage ---
HARNESS_DB_PATH=./harness.db
