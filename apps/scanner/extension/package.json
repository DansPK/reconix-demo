{
  "name": "reconix-code-scanner",
  "displayName": "Reconix Code Scanner",
  "description": "Chat-driven vulnerability scanning for your workspace, backed by the Reconix scanner server.",
  "version": "0.2.0",
  "publisher": "reconix",
  "icon": "media/logo.png",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reconixCodeScanner",
          "title": "Reconix Code Scanner",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "reconixCodeScanner": [
        {
          "type": "webview",
          "id": "reconixCodeScanner.chat",
          "name": "Chat"
        },
        {
          "id": "reconixCodeScanner.findings",
          "name": "Findings"
        }
      ]
    },
    "commands": [
      {
        "command": "reconixCodeScanner.setToken",
        "title": "Set Server Token",
        "category": "Reconix Code Scanner"
      },
      {
        "command": "reconixCodeScanner.clearToken",
        "title": "Clear Server Token",
        "category": "Reconix Code Scanner"
      },
      {
        "command": "reconixCodeScanner.reconnect",
        "title": "Reconnect to Server",
        "category": "Reconix Code Scanner"
      },
      {
        "command": "reconixCodeScanner.openSettings",
        "title": "Open Settings",
        "category": "Reconix Code Scanner"
      },
      {
        "command": "reconixCodeScanner.openChat",
        "title": "Open Chat",
        "category": "Reconix Code Scanner"
      },
      {
        "command": "reconixCodeScanner.newSession",
        "title": "New Session",
        "category": "Reconix Code Scanner"
      },
      {
        "command": "reconixCodeScanner.switchSession",
        "title": "Switch Session",
        "category": "Reconix Code Scanner"
      },
      {
        "command": "reconixCodeScanner.scanWorkspace",
        "title": "Scan Workspace",
        "category": "Reconix Code Scanner",
        "icon": "$(play)"
      },
      {
        "command": "reconixCodeScanner.rescan",
        "title": "Rescan",
        "category": "Reconix Code Scanner",
        "icon": "$(refresh)"
      },
      {
        "command": "reconixCodeScanner.scanPath",
        "title": "Scan with Reconix",
        "category": "Reconix Code Scanner",
        "icon": "$(shield)"
      },
      {
        "command": "reconixCodeScanner.scanGithub",
        "title": "Scan GitHub Repository",
        "category": "Reconix Code Scanner",
        "icon": "$(github)"
      },
      {
        "command": "reconixCodeScanner.cancelScan",
        "title": "Cancel Scan",
        "category": "Reconix Code Scanner",
        "icon": "$(debug-stop)"
      },
      {
        "command": "reconixCodeScanner.fixFindings",
        "title": "Fix Findings",
        "category": "Reconix Code Scanner",
        "icon": "$(wrench)"
      },
      {
        "command": "reconixCodeScanner.openFinding",
        "title": "Open Finding",
        "category": "Reconix Code Scanner"
      },
      {
        "command": "reconixCodeScanner.nextFinding",
        "title": "Next Finding",
        "category": "Reconix Code Scanner",
        "icon": "$(arrow-down)"
      },
      {
        "command": "reconixCodeScanner.previousFinding",
        "title": "Previous Finding",
        "category": "Reconix Code Scanner",
        "icon": "$(arrow-up)"
      },
      {
        "command": "reconixCodeScanner.revealFinding",
        "title": "Reveal Finding",
        "category": "Reconix Code Scanner"
      },
      {
        "command": "reconixCodeScanner.explainFinding",
        "title": "Explain Finding",
        "category": "Reconix Code Scanner",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "reconixCodeScanner.ignoreFinding",
        "title": "Ignore Finding",
        "category": "Reconix Code Scanner",
        "icon": "$(eye-closed)"
      },
      {
        "command": "reconixCodeScanner.clearIgnored",
        "title": "Show Ignored Findings Again",
        "category": "Reconix Code Scanner"
      },
      {
        "command": "reconixCodeScanner.explainSelection",
        "title": "Explain Selection",
        "category": "Reconix Code Scanner"
      },
      {
        "command": "reconixCodeScanner.fixFile",
        "title": "Fix Findings in File",
        "category": "Reconix Code Scanner",
        "icon": "$(wrench)"
      },
      {
        "command": "reconixCodeScanner.selectModel",
        "title": "Select Model",
        "category": "Reconix Code Scanner"
      },
      {
        "command": "reconixCodeScanner.setApiKey",
        "title": "Set API Key",
        "category": "Reconix Code Scanner"
      },
      {
        "command": "reconixCodeScanner.addModel",
        "title": "Add Model",
        "category": "Reconix Code Scanner"
      },
      {
        "command": "reconixCodeScanner.openWalkthrough",
        "title": "Open Getting Started Walkthrough",
        "category": "Reconix Code Scanner"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "reconixCodeScanner.scanWorkspace",
          "when": "view == reconixCodeScanner.chat && !reconixCodeScanner.scanRunning",
          "group": "navigation"
        },
        {
          "command": "reconixCodeScanner.rescan",
          "when": "view == reconixCodeScanner.chat && !reconixCodeScanner.scanRunning",
          "group": "navigation@1"
        },
        {
          "command": "reconixCodeScanner.cancelScan",
          "when": "view == reconixCodeScanner.chat && reconixCodeScanner.scanRunning",
          "group": "navigation"
        },
        {
          "command": "reconixCodeScanner.previousFinding",
          "when": "view == reconixCodeScanner.findings",
          "group": "navigation@1"
        },
        {
          "command": "reconixCodeScanner.nextFinding",
          "when": "view == reconixCodeScanner.findings",
          "group": "navigation@2"
        },
        {
          "command": "reconixCodeScanner.clearIgnored",
          "when": "view == reconixCodeScanner.findings",
          "group": "1_findings@1"
        }
      ],
      "explorer/context": [
        {
          "command": "reconixCodeScanner.scanPath",
          "when": "resourceScheme == file && !reconixCodeScanner.scanRunning",
          "group": "7_reconix@1"
        },
        {
          "command": "reconixCodeScanner.fixFile",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "7_reconix@4"
        }
      ],
      "editor/context": [
        {
          "command": "reconixCodeScanner.scanPath",
          "when": "resourceScheme == file && !reconixCodeScanner.scanRunning",
          "group": "7_reconix@3"
        },
        {
          "command": "reconixCodeScanner.explainSelection",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "7_reconix@4"
        },
        {
          "command": "reconixCodeScanner.fixFile",
          "when": "resourceScheme == file",
          "group": "7_reconix@5"
        }
      ],
      "editor/title/context": [
        {
          "command": "reconixCodeScanner.scanPath",
          "when": "resourceScheme == file && !reconixCodeScanner.scanRunning",
          "group": "7_reconix@1"
        }
      ],
      "commandPalette": [
        {
          "command": "reconixCodeScanner.scanPath",
          "when": "resourceScheme == file"
        },
        {
          "command": "reconixCodeScanner.cancelScan",
          "when": "reconixCodeScanner.scanRunning"
        },
        {
          "command": "reconixCodeScanner.fixFindings",
          "when": "false"
        },
        {
          "command": "reconixCodeScanner.openFinding",
          "when": "false"
        },
        {
          "command": "reconixCodeScanner.revealFinding",
          "when": "false"
        },
        {
          "command": "reconixCodeScanner.explainFinding",
          "when": "false"
        },
        {
          "command": "reconixCodeScanner.ignoreFinding",
          "when": "false"
        },
        {
          "command": "reconixCodeScanner.explainSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "reconixCodeScanner.fixFile",
          "when": "resourceScheme == file"
        }
      ],
      "view/item/context": [
        {
          "command": "reconixCodeScanner.explainFinding",
          "when": "view == reconixCodeScanner.findings && viewItem == finding",
          "group": "inline@1"
        },
        {
          "command": "reconixCodeScanner.ignoreFinding",
          "when": "view == reconixCodeScanner.findings && viewItem == finding",
          "group": "inline@2"
        },
        {
          "command": "reconixCodeScanner.explainFinding",
          "when": "view == reconixCodeScanner.findings && viewItem == finding",
          "group": "1_finding@1"
        },
        {
          "command": "reconixCodeScanner.ignoreFinding",
          "when": "view == reconixCodeScanner.findings && viewItem == finding",
          "group": "1_finding@2"
        }
      ]
    },
    "configuration": {
      "title": "Reconix Code Scanner",
      "properties": {
        "reconixCodeScanner.serverUrl": {
          "type": "string",
          "scope": "application",
          "default": "http://127.0.0.1:7357",
          "description": "Base URL of the Reconix scanner server. It must run on this computer."
        },
        "reconixCodeScanner.token": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "Server token. A token pasted here is moved to secure storage and cleared from settings."
        },
        "reconixCodeScanner.caCertificate": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "Path to a PEM CA certificate to trust for an HTTPS scanner server (optional)."
        },
        "reconixCodeScanner.maxFileSizeKB": {
          "type": "number",
          "default": 2048,
          "minimum": 1,
          "description": "Files larger than this are skipped when collecting the workspace."
        },
        "reconixCodeScanner.maxUploadMB": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Maximum size of the workspace archive sent for scanning."
        },
        "reconixCodeScanner.extraExcludes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra gitignore-style patterns to exclude from scans."
        },
        "reconixCodeScanner.scanOnSave": {
          "type": "boolean",
          "default": false,
          "description": "After a scan, rescan the folder a moment after you save a file in it (only changed files are sent)."
        },
        "reconixCodeScanner.showLikelyFalsePositives": {
          "type": "boolean",
          "default": false,
          "description": "Show findings the analyzer marked as likely false positives."
        },
        "reconixCodeScanner.gutterIcons": {
          "type": "boolean",
          "default": true,
          "description": "Show a coloured dot in the editor gutter on lines with findings."
        },
        "reconixCodeScanner.explorerBadges": {
          "type": "boolean",
          "default": true,
          "description": "Show the number of findings next to files in the Explorer."
        },
        "reconixCodeScanner.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show the number of findings above each function or class that has them, with a Fix button."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "reconixCodeScanner.findings",
        "contents": "No findings to show. A GitHub repository scan lists its findings in the chat.\n[Scan Workspace](command:reconixCodeScanner.scanWorkspace)\n[Getting Started Walkthrough](command:reconixCodeScanner.openWalkthrough)"
      }
    ],
    "walkthroughs": [
      {
        "id": "reconixCodeScanner.gettingStarted",
        "title": "Get started with Reconix Code Scanner",
        "description": "Scan your project for security vulnerabilities and fix them with AI.",
        "featuredFor": [
          "**/*.js",
          "**/*.ts",
          "**/*.py",
          "**/package.json"
        ],
        "steps": [
          {
            "id": "chooseMode",
            "title": "Configure server connection",
            "description": "Connect to the Reconix scanner server on this computer.\n[Open Settings](command:reconixCodeScanner.openSettings)",
            "media": {
              "markdown": "media/walkthrough/mode.md"
            }
          },
          {
            "id": "addModel",
            "title": "Add an AI model",
            "description": "The chat, analysis and fix agent need an AI model. Open the chat, choose Add Model, paste your key, then switch to it.\n[Open Chat](command:reconixCodeScanner.openChat)",
            "media": {
              "markdown": "media/walkthrough/model.md"
            }
          },
          {
            "id": "scan",
            "title": "Scan your project",
            "description": "Open your project folder, then scan it.\n[Scan Workspace](command:reconixCodeScanner.scanWorkspace)",
            "media": {
              "markdown": "media/walkthrough/scan.md"
            },
            "completionEvents": [
              "onCommand:reconixCodeScanner.scanWorkspace"
            ]
          },
          {
            "id": "reviewFix",
            "title": "Review findings and fix them",
            "description": "Findings are sorted by severity; click one to open the file at the line. Ask the chat to fix a finding, then review the diff before applying it.\n[Open Chat](command:reconixCodeScanner.openChat)",
            "media": {
              "markdown": "media/walkthrough/fix.md"
            }
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "reconixCodeScanner.nextFinding",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+.",
        "when": "editorTextFocus"
      },
      {
        "command": "reconixCodeScanner.previousFinding",
        "key": "ctrl+alt+,",
        "mac": "cmd+alt+,",
        "when": "editorTextFocus"
      },
      {
        "command": "reconixCodeScanner.openChat",
        "key": "ctrl+shift+alt+r",
        "mac": "cmd+shift+alt+r"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test:unit": "npm run compile-tests && node --test \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run build && npm run compile-tests && node out/test/integration/runTest.js",
    "test": "npm run test:unit && npm run test:integration",
    "package": "npm run build && npx -y @vscode/vsce package --allow-missing-repository --skip-license -o reconix-scanner.vsix",
    "server": "npm run compile-tests && node out/server/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ignore": "^7.0.12",
    "markdown-it": "^15.0.2",
    "tar": "^7.5.22",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
