/* T5 (execution / run log): the live output is a VerticalScroll of message lines and thinking
   blocks (widgets/run_log.py, thinking_block.py). Merge into reconix/reconix.tcss after the
   `RichLog, RunLog` rule (that rule still styles RunLog's box; keep it). */
.message-line {
    height: auto;
}

.thinking {
    height: auto;
}

.thinking-title {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.thinking-title:hover {
    background: $raised;
}

.thinking-title:focus {
    background: $cyan-bg;
}

.thinking-latest {
    height: 1;
    padding-left: 2;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.thinking-body {
    height: auto;
    padding-left: 2;
    border-left: vkey $border-strong;
    margin-left: 1;
}
