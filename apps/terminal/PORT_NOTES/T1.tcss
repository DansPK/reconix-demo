/* T1 (flow core): the chat inside a step, its pinned input, the tick / order lists.
   Merge into reconix/reconix.tcss next to `.feedback-echo` (keep that rule: base.py still
   echoes "Type something." feedback above the menu). The order list (PlanOrder) reuses
   `.tick-list`; its OptionList gets the same box as the SelectionList. */
.step-chat { height: auto; margin-top: 1; }
.chat-line { height: auto; margin-bottom: 1; }
.chat-bar { dock: bottom; height: auto; padding: 0 1; background: $bg; }
.chat-bar .menu-hint { margin: 0; }
.tick-list {
    height: auto;
    border: round $border-strong;
    padding: 0 1;
    margin-bottom: 1;
}
.tick-list SelectionList { height: auto; max-height: 14; background: $surface; }
.tick-list OptionList { height: auto; max-height: 14; background: $surface; }
