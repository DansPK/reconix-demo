/* T6 — help overlay. Replaces the existing #help-box rule in reconix.tcss. */
#help-box {
    width: 96%;              /* uses a wide terminal; long rows wrap under their own text */
    max-width: 104;
    height: auto;
    max-height: 100%;
    background: $surface;
    border: round $cyan-dim;
    border-title-color: $cyan;
    padding: 1 2;
}

#help-box .help-row { height: auto; }
#help-box .help-keys { width: 11; }
#help-box .help-desc { width: 1fr; }
