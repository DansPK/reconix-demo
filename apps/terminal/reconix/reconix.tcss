/* Reconix TUI — theme from the Figma design tokens.
   Dark security-tool look, cyan/teal accent, fixed severity scale. */

/* $variables come from theme.CSS_TOKENS (ReconixApp.get_css_variables). */

Screen {
    background: $bg;
    color: $text;
    layout: vertical;
}

/* One box, one background. A box on the screen (panel, table, list, log) has no fill of its
   own: it shows the screen's background and its rounded line marks it, so no strip of fill
   shows outside the line and nothing inside it (a note, a table header, a stripe, a scrollbar
   track) draws a second shade. Only states colour a row: the selected one, the hovered one.
   Dialogs float over the screen and keep one raised fill ($surface), shared by all inside. */
* {
    scrollbar-color: $border-strong;
    scrollbar-color-hover: $muted;
    scrollbar-color-active: $cyan-dim;
    scrollbar-background: $bg;
    scrollbar-background-hover: $bg;
    scrollbar-background-active: $bg;
    scrollbar-corner-color: $bg;
}

/* ...and a scrollbar inside an overlay runs on that overlay's fill. */
.dialog, .dialog *, #help-box, #help-box *, #command-bar, #command-bar *, Toast {
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-corner-color: $surface;
}

/* ------------------------------------------------------------ chrome */
/* The header: one quiet band of two rows (who/where/status, then the steps), set apart from
   the body by its surface colour instead of rules. */
SessionBar {
    height: 1;
    background: $surface2;
    color: $muted;
    padding: 0 2;
    border-bottom: none;
}

FlowProgress {
    height: 1;
    background: $surface2;
    padding: 0 2;
}

#body {
    height: 1fr;
    padding: 1 2 0 2;
    background: $bg;
    scrollbar-color: $border-strong;
    scrollbar-background: $bg;
    scrollbar-size-vertical: 1;
}

/* The footer: the same quiet band as the header, `key label` pairs with room between them. */
Footer {
    background: $surface2;
    color: $muted;
    padding: 0 2;
}

/* The side inset grows with the terminal (app.py sets the class): 2 columns below 100 wide, so
   80x24 keeps its layout, then 3. Header, body and footer share it, so their left edges line
   up. */
ReconixApp.-pad-m SessionBar, ReconixApp.-pad-m FlowProgress, ReconixApp.-pad-m Footer {
    padding: 0 3;
}
ReconixApp.-pad-m #body { padding: 1 3 0 3; }

/* On a big terminal the whole app floats inside the window: a row and two columns of space
   around it, so the header, its status and the footer never touch the window's edges. Only
   flow screens (not dialogs or the splash), and only with room to spare. */
ReconixApp.-frame ReconixScreen {
    padding: 1 2;
}

Footer FooterKey {
    background: $surface2;
    margin-right: 3;
}

FooterKey .footer-key--key {
    background: $surface2;
    color: $text;
    text-style: bold;
    padding: 0;
}

FooterKey .footer-key--description {
    background: $surface2;
    color: $muted;
    padding: 0 0 0 1;
}

FooterKey:hover,
FooterKey:hover .footer-key--key,
FooterKey:hover .footer-key--description {
    background: $raised;
}

/* ------------------------------------------------------------- text */
/* The operator's sent request: a highlighted bar, like Claude Code. */
.user-msg   { color: $text; background: $raised; padding: 0 1; margin-bottom: 1; }
/* Echo of free-text feedback typed at a question. */
.feedback-echo { height: auto; margin-bottom: 1; }

/* step chat + tick / order lists */
.step-chat { height: auto; margin-top: 1; }
.chat-line { height: auto; margin-bottom: 1; }
.chat-bar { dock: bottom; height: auto; padding: 0 1; background: $bg; }
.chat-bar .menu-hint { margin: 0; }
.tick-list {
    height: auto;
    border: round $border-strong;
    padding: 0 1;
    margin-bottom: 1;
}
.tick-list SelectionList { height: auto; max-height: 14; background: transparent; }
.tick-list OptionList { height: auto; max-height: 14; background: transparent; }
.ai-label   { color: $dim; margin-bottom: 1; }
.muted      { color: $muted; }
.dim        { color: $dim; }
.hint       { color: $dim; margin-top: 1; }

/* ------------------------------------------------------------ panels */
.panel {
    background: transparent;
    border: round $border;
    border-title-color: $text;
    border-title-style: bold;
    border-subtitle-color: $dim;
    padding: 0 2;
    height: auto;
    margin-bottom: 1;
}

.panel.accent   { border: round $cyan-dim; }
.panel.danger   { border: round $critical; border-title-color: $critical; }
.panel.success  { border: round $teal; }

.panel-body {
    height: auto;
    padding: 1 0;
}

.panel-note {
    color: $muted;
    background: $raised;
    padding: 0 1;
    height: auto;
    margin-bottom: 1;
}

/* Inside a box a note is plain text: the box's one background shows through. */
.panel .panel-note {
    background: transparent;
    padding: 0;
}

/* ------------------------------------------------------------ buttons
   Keyboard-first: buttons are visual affordances that mirror key bindings. */
.actions {
    height: auto;
    margin: 0 0 1 0;
}

Button {
    min-width: 12;
    height: 3;
    margin-right: 1;
    border: tall $border-strong;
    background: $surface;
    color: $text;
    text-style: bold;
}

Button:focus {
    text-style: bold reverse;
}

Button.primary {
    background: $teal;
    color: $bg;
    border: tall $teal;
}

Button.primary:hover { background: $cyan; border: tall $cyan; }

Button.ghost-cyan     { color: $cyan;     border: tall $cyan-dim; background: $surface; }
Button.ghost-critical { color: $critical; border: tall $critical; background: $surface; }
Button.ghost-cyan:hover, Button.ghost-critical:hover { background: $raised; }

Button:disabled {
    opacity: 50%;
}

/* The report's export chips: one row each, one background, read like the footer
   (`p  PDF`). The first is the main one. Unavailable: plain dim text, never faded. */
.export-actions {
    height: 1;
    margin: 1 0;
}

.export-label {
    width: auto;
    height: 1;
    margin-right: 2;
}

Button.export {
    width: auto;
    min-width: 0;
    height: 1;
    margin-right: 2;
    padding: 0 2;
    border: none;
    background: $raised;
    color: $text;
    text-style: none;
}

Button.export.-main {
    background: $cyan-bg;
}

Button.export:hover {
    background: $border-strong;
}

Button.export:focus {
    background: $cyan-dim;
    text-style: bold;
}

Button.export:disabled {
    opacity: 100%;
    background: $surface2;
}

/* ------------------------------------------------------------ inputs */
Input {
    background: $surface;
    border: tall $border-strong;
    color: $text;
    padding: 0 1;
}

Input:focus {
    border: tall $cyan-dim;
}

Input.match  { border: tall $teal; }
Input.nomatch { border: tall $critical; }
Input.caution { border: tall $medium; }

Input > .input--placeholder { color: $dim; }
Input > .input--cursor { background: $cyan; color: $bg; }

/* ------------------------------------------------- prompt (Claude-Code style) */
PromptBox {
    height: auto;
    margin: 0;  /* the body's inset already applies: the ❯ lines up with the header's ◆ */
}

#prompt {
    margin: 0;
}

/* Lines up with the text after the "❯ " mark, one row under the input's rule. */
#prompt-hint {
    height: 1;
    color: $dim;
    padding: 0 2;
}

/* An error or notice may wrap, but never grows past three lines. */
#prompt-hint.-message {
    height: auto;
    max-height: 3;
}

/* ------------------------------------------------- lists & tables (arrow keys) */
OptionList {
    background: transparent;
    border: round $border;
    padding: 0 1;
    height: auto;
    max-height: 18;
    scrollbar-color: $border-strong;
}

OptionList:focus {
    border: round $cyan-dim;
}

OptionList > .option-list--option-highlighted {
    background: $raised;
    color: $text;
    text-style: bold;
}

OptionList:focus > .option-list--option-highlighted {
    background: $cyan-bg;
    color: $text;
}

OptionList > .option-list--separator {
    color: $border;
}

/* ---------------------------------------- choice menus (after OptionList rules) */
ChoiceMenu {
    background: $bg;
    border: none;
    padding: 0;
    height: auto;
    max-height: 12;
}

/* Textual tints focused lists; menus stay flat. */
ChoiceMenu:focus {
    border: none;
    background-tint: $bg 0%;
}

/* Like Claude Code: the pointer and colour mark the choice, no background band. */
ChoiceMenu > .option-list--option-highlighted,
ChoiceMenu:focus > .option-list--option-highlighted {
    background: $bg;
    text-style: none;
}

ChoiceMenu > .option-list--separator {
    color: $border-strong;
}

ChoiceMenu > .option-list--option-hover {
    background: $raised;
}

/* Floats above the prompt input (first child + overlay + lifted by its own height). */
SuggestionMenu > .option-list--option-highlighted {
    background: $surface2;
}

SuggestionMenu {
    display: none;
    overlay: screen;
    constrain: none inside;
    offset-y: -100%;
    width: 100%;
    background: $surface2;
    /* A whole box: it floats over what is above the prompt (the Start card at 80×24), so it
       must read as a popup, not as a row cut into that card's border. */
    border: tall $border-strong;
    padding: 0 1;
    max-height: 10;
    scrollbar-background: $surface2;
    scrollbar-background-hover: $surface2;
    scrollbar-background-active: $surface2;
}

/* Question widget: chip, bold question, numbered choices, key hint. */
Question {
    height: auto;
}

.chip {
    width: auto;
    height: 1;
    padding: 0 1;
    margin-bottom: 1;
    background: $cyan-dim;
    color: $text;
    text-style: bold;
}

Question.danger .chip {
    background: $critical;
    color: $bg;
}

.question {
    color: $text;
    text-style: bold;
    margin-bottom: 1;
}

.menu-hint {
    color: $dim;
    margin: 1 0;
}

DataTable {
    background: transparent;
    scrollbar-size-horizontal: 0;  /* Shift+←/→ scrolls; the hint says so, no grey band */
    height: auto;
    max-height: 16;
    border: round $border;
    scrollbar-color: $border-strong;
}

DataTable:focus {
    border: round $cyan-dim;
}

DataTable > .datatable--header {
    background: transparent;
    color: $dim;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $cyan-bg;
    color: $text;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: $raised;
}

DataTable > .datatable--odd-row,
DataTable > .datatable--fixed,
DataTable > .datatable--even-row {
    background: transparent;
}

/* ------------------------------------------- execution (no percentages: a spinner) */
.task-row {
    height: 1;
    margin: 0;
}

#exec-spinner {
    height: 1;
    margin-top: 1;
}

/* --------------------------------------------------------------- log */
RichLog, RunLog {
    background: transparent;
    border: round $border;
    border-title-color: $muted;
    border-subtitle-color: $dim;
    height: 12;
    padding: 0 1;
    scrollbar-color: $border-strong;
}

/* run log: message lines + thinking blocks */
.message-line {
    height: auto;
}

.thinking {
    height: auto;
}

.thinking-title {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.thinking-title:hover {
    background: $raised;
}

.thinking-title:focus {
    background: $cyan-bg;
}

.thinking-latest {
    height: 1;
    padding-left: 2;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.thinking-body {
    height: auto;
    padding-left: 2;
    border-left: vkey $border-strong;
    margin-left: 1;
}

/* The live output takes the rest of the Execution screen. */
#live-log {
    height: 1fr;
    min-height: 6;
}

/* ------------------------------------------------------- start screen */
#start-center {
    height: 1fr;
    align: center middle;
}

#logo {
    width: auto;
    color: $cyan;
    text-style: bold;
    content-align: center middle;
}

#tagline, #version-line, #no-scope {
    width: 100%;
    content-align: center middle;
    text-align: center;
}

#tagline      { color: $muted; margin-top: 1; }
#version-line { color: $dim; }
#no-scope     { color: $muted; margin-top: 1; }

#quickstart {
    width: 80;
    max-width: 100%;
    margin-top: 1;
}

/* After the first input: your line on top, then Reconix's answer or its spinner. */
#start-conversation {
    height: 1fr;
    scrollbar-color: $border-strong;
    scrollbar-background: $bg;
    scrollbar-size-vertical: 1;
}

#start-reply {
    height: auto;
}

/* -------------------------------------------------- findings / detail */
#sev-strip {
    height: 1;
    margin-bottom: 1;
}

#view-line {
    height: 1;
}

#findings-empty {
    display: none;
}

#preview {
    margin-top: 1;
}

/* The highlighted finding, under the table (hidden on short terminals, findings_list.py). */
#finding-preview {
    margin-top: 1;
    border-title-color: $muted;
}

#detail-empty {
    margin-top: 1;
}

#detail-header {
    height: auto;
}

#detail-cols {
    height: auto;
}

#detail-cols > .panel {
    width: 1fr;
    margin-right: 1;
}

#detail-cols > .panel:last-of-type {
    margin-right: 0;
}

/* ------------------------------------------------------------ report */
#sev-chart {
    height: auto;
}

/* --------------------------------------------------------- help modal */
HelpScreen {
    align: center middle;
    background: $bg 70%;
}

#help-box {
    width: 96%;              /* uses a wide terminal; long rows wrap under their own text */
    max-width: 104;
    height: auto;
    max-height: 100%;
    background: $surface;
    border: tall $cyan-dim;  /* half-block edge: the fill stops at the line */
    border-title-color: $cyan;
    padding: 1 2;
}

#help-box .help-row { height: auto; }
#help-box .help-keys { width: 11; }
#help-box .help-desc { width: 1fr; }

/* -------------------------------------------------------- command bar */
CommandBarScreen {
    align: center bottom;
    background: $bg 40%;
}

#command-bar {
    width: 100%;
    height: auto;
    background: $surface;
    border-top: solid $border-strong;
    padding: 1 2 0 2;
}

/* ------------------------------------------------------------ dialogs */
ChoiceScreen {
    align: center middle;
    background: $bg 70%;
}

.dialog {
    width: 96;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    background: $surface;
    border: tall $cyan-dim;  /* half-block edge: the fill stops at the line */
    border-title-color: $cyan;
    border-title-style: bold;
    padding: 1 2;
}

.dialog.danger {
    border: tall $critical;
    border-title-color: $critical;
}

.dialog ChoiceMenu,
.dialog ChoiceMenu > .option-list--option-highlighted,
.dialog ChoiceMenu:focus > .option-list--option-highlighted {
    background: $surface;
}

/* Full shorthand: a lone margin-bottom would reset the other sides to 0. */
.dialog .menu-hint {
    margin: 1 0 0 0;
}

.dialog-body {
    height: auto;
    max-height: 60vh;
    margin-bottom: 1;
    scrollbar-color: $border-strong;
    scrollbar-background: $surface;
    scrollbar-size-vertical: 1;
}

/* ------------------------------------------------------------- notifications
   Toast has inherit_css=False, so it needs its own type selector. */
Toast {
    background: $surface;
    color: $text;
    padding: 0 1;
}

Toast.-information {
    border-left: outer $cyan;
}

Toast.-warning {
    border-left: outer $medium;
}

Toast.-error {
    border-left: outer $critical;
}


/* ------------------------------------------------------------- forms */
FormScreen {
    align: center middle;
    background: $bg 70%;
}

.dialog.form {
    width: 80;
}

.dialog.form Input {
    margin-bottom: 1;
}

.form-note {
    color: $muted;
    margin-bottom: 1;
    height: auto;
}

.field-label {
    color: $muted;
    text-style: bold;
}

.field-label.-warn {
    color: $medium;
}

/* The fields scroll inside the form; the error line and the buttons stay pinned under them. */
.form-body {
    height: auto;
    scrollbar-color: $border-strong;
    scrollbar-background: $surface;
    scrollbar-size-vertical: 1;
}

/* "↓ more fields below": shown only while some fields are below the fold */
#form-more {
    height: 1;
}

#form-error {
    color: $critical;
    height: auto;
}

#form-error:focus {
    background: $cyan-bg;
}

.form-actions {
    height: auto;
    margin-top: 1;
}

/* ------------------------------------------------- template / plan / approval */
.spinner {
    height: 1;
    margin-bottom: 1;
}

/* A spinner line that Ctrl+O expands into the steps Reconix finished. */
.activity {
    height: auto;
    margin-bottom: 1;
}

#target-row {
    height: auto;
    margin-top: 1;
}

#target-row .field-label {
    margin-bottom: 0;
}

#target-error {
    color: $critical;
    height: auto;
}

.approval-row {
    height: auto;
}

/* ------------------------------------------------------------ execution */
#exec-hint {
    height: auto;
    margin-top: 1;
}

/* approval */
ApprovalScreen .menu-hint { margin-bottom: 0; }
