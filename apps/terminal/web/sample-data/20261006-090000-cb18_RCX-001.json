  "findings": [
    {
      "id": "004",
      "severity": "CRITICAL",
      "title": "SQL injection in product search",
      "path": "/api/products",
      "validation": "CONFIRMED",
      "description": "The 'category' parameter is concatenated into a SQL query. A boolean probe changed the result set and a time-based payload delayed the response, confirming injection.",
      "affected_url": "https://www.lumina.com/api/products?category=",
      "impact": "An attacker could read or modify the product and customer database, including order records and password hashes.",
      "remediation": "Use parameterized queries / prepared statements for every database call and run the app with a least-privilege database account.",
      "tool": "Nuclei",
      "references": [
        "OWASP A03:2021",
        "CWE-89"
      ],
      "evidence": [
        "GET /api/products?category=1' AND SLEEP(5)-- → response delayed 5.02s",
        "category=1 AND 1=1 → 142 rows · category=1 AND 1=2 → 0 rows",
        "error probe leaked DBMS banner: MySQL 5.7.x"
      ],
      "cvss_score": 9.8,
      "cvss_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H",
      "category": "Web App",
