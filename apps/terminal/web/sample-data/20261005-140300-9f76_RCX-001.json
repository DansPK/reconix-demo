  "findings": [
    {
      "id": "004",
      "severity": "CRITICAL",
      "title": "SQL injection in catalog search",
      "path": "/api/v1/products",
      "validation": "CONFIRMED",
      "description": "The storefront catalog search is reachable without signing in, and the search term (the q parameter on GET /api/v1/products) is concatenated straight into a SQL query. A single always-true payload — ' OR 1=1 -- — made the search return every row, and a UNION payload pulled the customer table, confirming full read access to the database.",
      "affected_url": "https://staging.lumina.com/api/v1/products?q=",
      "impact": "An unauthenticated attacker can read the entire customer database: names, emails, phone numbers, delivery addresses, saved card numbers, and password hashes. The passwords are stored as unsalted MD5 and crack back to plaintext in seconds.",
      "remediation": "Use parameterized queries / prepared statements for every database call and run the app with a least-privilege database account. Store passwords with a slow salted hash (bcrypt or argon2), and never keep full card numbers, tokenize payments instead.",
      "tool": "Nuclei",
      "references": [
        "OWASP A03:2021",
        "CWE-89"
      ],
      "evidence": [
        "GET /api/v1/products?q=cotton' OR '1'='1-- -   ->  HTTP 200 · all 48,215 rows (no auth)",
