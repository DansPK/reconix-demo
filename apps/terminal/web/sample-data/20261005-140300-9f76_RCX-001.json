      "title": "Unauthenticated access to order records",
      "path": "/api/orders/{id}",
      "validation": "CONFIRMED",
      "description": "The order endpoint returns any order by its ID with no authentication. A request carrying no session cookie or API key returned an order that belongs to another customer.",
