{
  "name": "vuln-scanner",
  "displayName": "Reconix",
  "description": "Scan your code for vulnerabilities with a self-hosted scanner harness, and chat about the findings.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vulnScanner.setToken",
        "title": "Set Token",
        "category": "Reconix"
      },
      {
        "command": "vulnScanner.clearToken",
        "title": "Clear Token",
        "category": "Reconix"
      },
      {
        "command": "vulnScanner.openChat",
        "title": "Open Chat",
        "category": "Reconix"
      },
      {
        "command": "vulnScanner.newSession",
        "title": "New Session",
        "category": "Reconix"
      },
      {
        "command": "vulnScanner.scanWorkspace",
        "title": "Scan Workspace",
        "category": "Reconix"
      },
      {
        "command": "vulnScanner.rescan",
        "title": "Rescan",
        "category": "Reconix",
        "icon": "$(refresh)"
      },
      {
        "command": "vulnScanner.cancelScan",
        "title": "Cancel Scan",
        "category": "Reconix"
      },
      {
        "command": "vulnScanner.selectModel",
        "title": "Select LLM Model",
        "category": "Reconix"
      },
      {
        "command": "vulnScanner.fixFinding",
        "title": "Fix Finding",
        "category": "Reconix",
        "icon": "$(wrench)"
      },
      {
        "command": "vulnScanner.fixFindings",
        "title": "Fix Findings",
        "category": "Reconix"
      },
      {
        "command": "vulnScanner.fixFile",
        "title": "Fix All Findings in This File",
        "category": "Reconix",
        "icon": "$(wrench)"
      },
      {
        "command": "vulnScanner.explainFinding",
        "title": "Explain Finding in Chat",
        "category": "Reconix",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "vulnScanner.ignoreFinding",
        "title": "Ignore Finding",
        "category": "Reconix",
        "icon": "$(eye-closed)"
      },
      {
        "command": "vulnScanner.clearIgnored",
        "title": "Show Ignored Findings Again",
        "category": "Reconix"
      },
      {
        "command": "vulnScanner.openFindingById",
        "title": "Open Finding",
        "category": "Reconix"
      },
      {
        "command": "vulnScanner.revealFinding",
        "title": "Show Finding in the Findings View",
        "category": "Reconix"
      },
      {
        "command": "vulnScanner.nextFinding",
        "title": "Go to Next Finding",
        "category": "Reconix"
      },
      {
        "command": "vulnScanner.previousFinding",
        "title": "Go to Previous Finding",
        "category": "Reconix"
      },
      {
        "command": "vulnScanner.scanPath",
        "title": "Scan with Reconix",
        "category": "Reconix",
        "icon": "$(shield)"
      },
      {
        "command": "vulnScanner.explainSelection",
        "title": "Ask Reconix About This Code",
        "category": "Reconix"
      }
    ],
    "configuration": {
      "title": "Reconix",
      "properties": {
        "vulnScanner.serverUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of the scanner harness, for example https://scanner.example.com"
        },
        "vulnScanner.token": {
          "type": "string",
          "default": "",
          "markdownDescription": "Paste your token here to sign in. The extension moves it into VS Code's secure storage and clears this field, so it does not stay in your settings file. (Same as running **Reconix: Set Token**.)"
        },
        "vulnScanner.caCertificate": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a PEM certificate to trust for HTTPS, for example the harness's self-signed `certs/dev-cert.pem`. Trusted in addition to the normal certificates. `~` is allowed."
        },
        "vulnScanner.maxFileSizeKB": {
          "type": "number",
          "default": 2048,
          "minimum": 1,
          "description": "Files larger than this are skipped."
        },
        "vulnScanner.maxUploadMB": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Stop before uploading an archive larger than this."
        },
        "vulnScanner.extraExcludes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra glob patterns to skip (gitignore syntax)."
        },
        "vulnScanner.showLikelyFalsePositives": {
          "type": "boolean",
          "default": false,
          "description": "Show findings the LLM marked as likely false alarms."
        },
        "vulnScanner.gutterIcons": {
          "type": "boolean",
          "default": true,
          "description": "Show a coloured dot next to the line numbers on lines with findings."
        },
        "vulnScanner.explorerBadges": {
          "type": "boolean",
          "default": true,
          "description": "Show a finding count on files in the Explorer, and colour the folders above them."
        },
        "vulnScanner.codeLens": {
          "type": "boolean",
          "default": false,
          "description": "Show a line above each function with findings, with a Fix button."
        },
        "vulnScanner.scanOnSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Rescan automatically a moment after you save a file in the scanned folder (only changed files are uploaded)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vulnScanner",
          "title": "Reconix Code Scanner",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "vulnScanner": [
        {
          "type": "webview",
          "id": "vulnScanner.chat",
          "name": "Chat"
        },
        {
          "id": "vulnScanner.findings",
          "name": "Findings"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "vulnScanner.fixFinding",
          "when": "false"
        },
        {
          "command": "vulnScanner.fixFindings",
          "when": "false"
        },
        {
          "command": "vulnScanner.explainFinding",
          "when": "false"
        },
        {
          "command": "vulnScanner.ignoreFinding",
          "when": "false"
        },
        {
          "command": "vulnScanner.openFindingById",
          "when": "false"
        },
        {
          "command": "vulnScanner.revealFinding",
          "when": "false"
        },
        {
          "command": "vulnScanner.scanPath",
          "when": "false"
        },
        {
          "command": "vulnScanner.explainSelection",
          "when": "editorHasSelection"
        }
      ],
      "explorer/context": [
        {
          "command": "vulnScanner.scanPath",
          "when": "resourceScheme == file",
          "group": "7_reconix@1"
        }
      ],
      "editor/context": [
        {
          "command": "vulnScanner.explainSelection",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "7_reconix@1"
        },
        {
          "command": "vulnScanner.fixFile",
          "when": "resourceScheme == file",
          "group": "7_reconix@2"
        },
        {
          "command": "vulnScanner.scanPath",
          "when": "resourceScheme == file",
          "group": "7_reconix@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "vulnScanner.scanPath",
          "when": "resourceScheme == file",
          "group": "7_reconix@1"
        }
      ],
      "view/title": [
        {
          "command": "vulnScanner.rescan",
          "when": "view == vulnScanner.findings",
          "group": "navigation@1"
        },
        {
          "command": "vulnScanner.clearIgnored",
          "when": "view == vulnScanner.findings",
          "group": "more@1"
        }
      ],
      "view/item/context": [
        {
          "command": "vulnScanner.fixFinding",
          "when": "view == vulnScanner.findings && viewItem == finding",
          "group": "inline@1"
        },
        {
          "command": "vulnScanner.explainFinding",
          "when": "view == vulnScanner.findings && viewItem == finding",
          "group": "inline@2"
        },
        {
          "command": "vulnScanner.ignoreFinding",
          "when": "view == vulnScanner.findings && viewItem == finding",
          "group": "inline@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vulnScanner.nextFinding",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+.",
        "when": "editorTextFocus"
      },
      {
        "command": "vulnScanner.previousFinding",
        "key": "ctrl+alt+,",
        "mac": "cmd+alt+,",
        "when": "editorTextFocus"
      },
      {
        "command": "vulnScanner.openChat",
        "key": "ctrl+shift+alt+r",
        "mac": "cmd+shift+alt+r"
      }
    ],
    "viewsWelcome": [
      {
        "view": "vulnScanner.findings",
        "contents": "No findings yet.\n[Scan Workspace](command:vulnScanner.scanWorkspace)\nOr right-click a file or folder in the Explorer and choose **Scan with Reconix**."
      }
    ],
    "walkthroughs": [
      {
        "id": "reconix.start",
        "title": "Get started with Reconix",
        "description": "Connect to your scanner server, pick a model, and run your first scan.",
        "steps": [
          {
            "id": "server",
            "title": "Connect to your harness",
            "description": "Point Reconix at your scanner server.\n[Open Settings](command:vulnScanner.openSettings)",
            "media": {
              "markdown": "media/walkthrough/server.md"
            },
            "completionEvents": [
              "onSettingChanged:vulnScanner.serverUrl"
            ]
          },
          {
            "id": "token",
            "title": "Add your token",
            "description": "Paste the token your admin gave you. It is kept in VS Code's secure storage.\n[Set Token](command:vulnScanner.setToken)",
            "media": {
              "markdown": "media/walkthrough/token.md"
            },
            "completionEvents": [
              "onCommand:vulnScanner.setToken"
            ]
          },
          {
            "id": "model",
            "title": "Choose an AI model",
            "description": "Use Reconix's server model, or a custom OpenAI- or Anthropic-compatible API.\n[Choose Model](command:vulnScanner.selectModel)",
            "media": {
              "markdown": "media/walkthrough/model.md"
            },
            "completionEvents": [
              "onCommand:vulnScanner.selectModel"
            ]
          },
          {
            "id": "scan",
            "title": "Run your first scan",
            "description": "Scan the open folder. Findings appear in the editor, the Problems panel and the Findings view.\n[Scan Workspace](command:vulnScanner.scanWorkspace)",
            "media": {
              "markdown": "media/walkthrough/scan.md"
            },
            "completionEvents": [
              "onCommand:vulnScanner.scanWorkspace"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test:unit": "npm run compile-tests && node --test \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run build && npm run compile-tests && node out/test/integration/runTest.js",
    "test": "npm run test:unit && npm run test:integration",
    "fake-server": "npm run compile-tests && node out/test/fakeServer.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ignore": "^7.0.12",
    "markdown-it": "^15.0.2",
    "tar": "^7.5.22",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
