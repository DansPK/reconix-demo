# Copy to .env and fill in.
HARNESS_PUBLIC_URL=http://localhost:8080
HARNESS_SIGNING_SECRET=change-me-to-a-long-random-string

# --- LLM (optional): the default "reconix" provider, seeded into the flexible-model store on first
# start. Users can add a custom API provider (OpenAI-compatible or Anthropic-compatible) and switch at
# runtime from the VS Code model picker; its key is stored Fernet-encrypted on /data. Leave these blank to
# start with no model and pick one in the UI. LLM_MODEL uses LiteLLM's naming, e.g. openai/qwen2.5-coder.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=openai/your-model-name

# --- Delegated scanning via the Kali MCP container (see deploy/README.md). Leave KALI_MCP_URL
# blank to run the local scanner binaries instead.
KALI_MCP_URL=http://host.docker.internal:8090/mcp
KALI_MCP_AUTH_TOKEN=change-me-shared-with-the-kali-container
# KALI_WORKSPACE_MAP=/data=/workspace                 # host=container path prefixes of the shared volume

# --- SonarQube: the Kali container's bundled server (H2). Bootstrap a token, then set it here.
SONAR_HOST_URL=http://host.docker.internal:9000
SONAR_TOKEN=paste-sonarqube-token-here

# Web search for the agents (SearXNG in docker-compose). setup.sh fills in the secret.
SEARXNG_SECR
# WEB_SEARCH_URL=          # uncomment (empty) to turn the agents' web search off
